{
    "components": {
        "schemas": {
            "common.ErrorResponse": {
                "properties": {
                    "error": {
                        "example": "Invalid state",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "controllers.AuthCallbackResponse": {
                "properties": {
                    "message": {
                        "example": "Login successful",
                        "type": "string"
                    },
                    "sub": {
                        "example": "auth0|1234567890",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "main.VaultResponse": {
                "properties": {
                    "message": {
                        "example": "Welcome to your secure vault",
                        "type": "string"
                    },
                    "sub": {
                        "example": "auth0|1234567890",
                        "type": "string"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "BearerAuth": {
                "description": "Enter \"Bearer \" followed by your JWT token.",
                "in": "header",
                "name": "Authorization",
                "type": "apiKey"
            }
        }
    },
    "info": {
        "contact": {},
        "description": "Secure self-hosted document archival API",
        "title": "Enklave API",
        "version": "1.0"
    },
    "openapi": "3.0.3",
    "paths": {
        "/api/vault": {
            "get": {
                "description": "Returns secure vault message and subject identity for authenticated user",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/main.VaultResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/common.ErrorResponse"
                                }
                            }
                        },
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "summary": "Access secure vault",
                "tags": [
                    "vault"
                ]
            }
        },
        "/auth/callback": {
            "get": {
                "description": "Handles OIDC authentication callback, verifies token, and creates user session",
                "parameters": [
                    {
                        "description": "OAuth2 state parameter",
                        "in": "query",
                        "name": "state",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "OAuth2 authorization code",
                        "in": "query",
                        "name": "code",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/controllers.AuthCallbackResponse"
                                }
                            }
                        },
                        "description": "Login successful"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/common.ErrorResponse"
                                }
                            }
                        },
                        "description": "Invalid state"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/common.ErrorResponse"
                                }
                            }
                        },
                        "description": "Authentication or token verification error"
                    }
                },
                "summary": "OIDC callback",
                "tags": [
                    "auth"
                ]
            }
        },
        "/auth/login": {
            "get": {
                "description": "Redirects to the OIDC identity provider for authentication",
                "responses": {
                    "302": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Redirects to OIDC provider auth URL"
                    }
                },
                "summary": "OIDC login",
                "tags": [
                    "auth"
                ]
            }
        }
    }
}
